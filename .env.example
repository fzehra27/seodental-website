# Copy to ".env" and fill in. NEVER commit ".env". It is not served by the web server.

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Public address of the site (used for documentation/logging only).
PUBLIC_URL=https://www.example.com

# Set true ONLY when a reverse proxy (nginx, Caddy, Cloudflare...) terminates HTTPS in front of Node
# and sets X-Forwarded-For. Needed so rate limiting sees the real visitor IP.
TRUST_PROXY=false

# REQUIRED in production: a long random secret (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Cookies get the "Secure" flag (and the __Host- prefix). Keep true when the site runs on HTTPS.
# Set false only for plain-http local testing.
COOKIE_SECURE=true

# SQLite database file (relative to the project folder). Back this file up regularly.
DATABASE_FILE=data/seodental.sqlite

# Session policy: signed out after this many idle hours, or this many days in total.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=14

# ---------------- E-mail verification (SMTP) ----------------
# EMAIL_PROVIDER=none  -> no e-mail is sent; accounts stay "Doğrulanmadı" and the UI says so.
EMAIL_PROVIDER=none
# SMTP_HOST=mail.example.com
# SMTP_PORT=587                  # 587 = STARTTLS, 465 = implicit TLS
# SMTP_SECURE=false              # true for port 465
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-mailbox-password
# SMTP_FROM=SeoDental <noreply@example.com>

# ---------------- SMS verification ----------------
# SMS_PROVIDER=none | netgsm | twilio
SMS_PROVIDER=none
# --- Netgsm (Turkey) ---
# NETGSM_USERCODE=
# NETGSM_PASSWORD=
# NETGSM_MSGHEADER=              # your approved sender title (mesaj başlığı)
# --- Twilio ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1XXXXXXXXXX       # or use TWILIO_MESSAGING_SERVICE_SID instead
# TWILIO_MESSAGING_SERVICE_SID=
